# Doména, na které poběží webové rozhraní (DNS A záznam -> veřejná IP serveru)
NVR_DOMAIN=nvr.example.cz
ACME_EMAIL=admin@example.cz

# Kam je na serveru připojený NAS
NVR_STORAGE=/mnt/nvr

# Hesla ke kamerám (použitá v config.yaml jako ${CAM1_PASSWORD} ...)
CAM_USER=admin
CAM1_PASSWORD=
CAM2_PASSWORD=
