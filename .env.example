# Doména, na které poběží webové rozhraní (DNS A záznam -> veřejná IP serveru)
NVR_DOMAIN=nvr.example.cz
ACME_EMAIL=admin@example.cz

# HTTPS: "caddy" = vestavěný Caddy na portech 80/443; prázdné = vlastní reverzní proxy
COMPOSE_PROFILES=caddy
# Adresa a port, na kterých je FarNVR dostupný pro reverzní proxy
NVR_BIND=127.0.0.1
NVR_PORT=8090
# IP reverzní proxy, které může FarNVR věřit hlavičku X-Forwarded-For (* = všem)
FORWARDED_ALLOW_IPS=*

# Kam je na serveru připojený NAS
NVR_STORAGE=/mnt/nvr

# Hesla ke kamerám (použitá v config.yaml jako ${CAM1_PASSWORD} ...)
CAM_USER=admin
CAM1_PASSWORD=
CAM2_PASSWORD=
